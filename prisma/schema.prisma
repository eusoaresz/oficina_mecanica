generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Cliente {
  id           Int         @id @default(autoincrement())
  nome         String      @db.VarChar(60) 
  telefone     String      @db.VarChar(20)
  saldo        Decimal     @db.Decimal(9,2) @default(0)
  email        String      @db.VarChar(60) 
  veiculos      Veiculo[]
  depositos     Deposito[]
  @@map("clientes")
}

model Veiculo {
  id           Int         @id @default(autoincrement())
  modelo       String      @db.VarChar(30) 
  marca        String      @db.VarChar(30) 
  placa        String      @db.VarChar(40) 
  ano          Decimal     @db.Decimal(4,0)
  status       String?     @db.Text
  clienteId    Int
  cliente      Cliente     @relation(fields: [clienteId], references: [id])
  ordensServico OrdemServico[]
  @@map("veiculos")
}

model OrdemServico {
  id           Int                  @id @default(autoincrement())
  dataEntrada  DateTime             @default(now()) @map("data_entrada")
  dataSaida    DateTime?            @map("data_saida")
  status       StatusOrdemServico   @default(ABERTA)
  valor        Decimal              @db.Decimal(9,2)
  veiculoId    Int                  @map("VeiculoId")
  veiculo      Veiculo              @relation(fields: [veiculoId], references: [id])
  servicoId    Int                  @map("ServicoId")
  servico      Servico              @relation(fields: [servicoId], references: [id])
  @@map("ordens_servico")
}

model Servico {
  id         Int        @id @default(autoincrement())
  descricao  String     @db.VarChar(60) 
  valor      Decimal    @db.Decimal(9,2)
  ordensServico OrdemServico[]
  @@map("servicos")
}

model Deposito {
  id         Int        @id @default(autoincrement())
  cliente    Cliente      @relation(fields: [clienteId], references: [id])
  clienteId  Int
  valor      Decimal    @db.Decimal(9,2)
  tipo       Tipos
  data       DateTime   @default(now())
  @@map("depositos")
}

enum Tipos {
  PIX
  Dinheiro
  Cartao
}

enum StatusOrdemServico {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PAGAMENTO
  CONCLUIDA
  CANCELADA
}